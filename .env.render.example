# =============================
# ENTORNO: Render (referencia)
# =============================
# Estas variables se configuran en el dashboard de Render (o en render.yaml).
# DATABASE_URL la inyecta Render automáticamente al conectar la base de datos.
# No copiar este archivo a producción; es solo una referencia.

# Configuración general
DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=  -> se genera automáticamente en render.yaml
# DJANGO_ALLOWED_HOSTS=  -> opcional; RENDER_EXTERNAL_HOSTNAME se añade solo

# Base de datos (solo si NO se usa DATABASE_URL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=uh_db
# DB_USER=uh_user
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# CORS: origen del frontend desplegado
CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com

# Media (disco persistente montado en ./media)
# MEDIA_ROOT=

# Arranque (start.sh)
# IMPORT_FIXTURES_ON_START=true  # habilitar solo si la BD está vacía ANTES de migrar
IMPORT_FIXTURES_ON_START=false
FIXTURES_CSV_PATH=fixtures/csv
CREATE_SUPERUSER_ON_START=true

# URLs públicas (referencia)
FRONTEND_URL=https://tu-frontend.onrender.com
BACKEND_URL=https://uh-backend.onrender.com
