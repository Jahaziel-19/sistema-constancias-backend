# =============================
# ENTORNO: Render (referencia)
# =============================
# Copia este archivo como .env y configura los valores reales, o configúralos
# directamente en el dashboard de Render (Web Service -> Environment).
# DATABASE_URL la inyecta Render automáticamente al conectar la base de datos.
# No subir este archivo con valores reales a git (ver .gitignore).

# --- Django ---
# Obligatoria: genera una clave larga y aleatoria (ej: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cambiar-por-una-clave-segura-de-al menos-50-caracteres
# Omitir o false en producción
DJANGO_DEBUG=false
# Opcional: hosts permitidos. Render añade RENDER_EXTERNAL_HOSTNAME automáticamente.
# DJANGO_ALLOWED_HOSTS=mi-dominio.com,otro-dominio.com

# --- Base de datos ---
# Render inyecta DATABASE_URL al conectar PostgreSQL. Si usas una DB externa,
# pega la connection string en DATABASE_URL o configura DB_* manualmente.
# DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:PORT/NOMBRE_BD
# Alternativa: variables individuales (solo si NO usas DATABASE_URL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sistema_constancias
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=tu-host.oregon-postgres.render.com
DB_PORT=5432

# --- Cloudinary (media) ---
# Obligatorias: obtener CLOUD_NAME, API_KEY, API_SECRET en tu cuenta de Cloudinary.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Ruta local usada solo para leer los logos del pipeline de PDF (copiados en cada arranque).
# MEDIA_ROOT=

# --- CORS / frontend ---
# Origen del frontend desplegado: SOLO esquema + host, SIN path ni barra al final.
# django-cors-headers rechaza URLs con path (ej: ...vercel.app/ -> ...vercel.app)
CORS_ALLOWED_ORIGINS=https://sistema-constancias-frontend.vercel.app

# --- Arranque (start.sh) ---
# IMPORT_FIXTURES_ON_START=true  # habilitar solo si la BD está vacía ANTES de migrar
IMPORT_FIXTURES_ON_START=false
FIXTURES_CSV_PATH=fixtures/csv
CREATE_SUPERUSER_ON_START=true

# --- URLs públicas (referencia) ---
FRONTEND_URL=https://sistema-constancias-frontend.vercel.app
BACKEND_URL=https://uh-backend.onrender.com